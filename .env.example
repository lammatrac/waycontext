# PostgreSQL connection (pgvector extension required)
DATABASE_URL=postgres://codectx:codectx@localhost:5432/codectx

# Embedding provider: "voyage" | "openai" | "none"
# "none" disables vector search (graph + keyword tools still work)
EMBEDDING_PROVIDER=voyage

# Voyage AI (recommended for code: voyage-code-3)
VOYAGE_API_KEY=
VOYAGE_MODEL=voyage-code-3
# Optional, USD per 1M tokens — enables `codecontext usage` to estimate cost.
# Check current pricing at https://docs.voyageai.com/docs/pricing (rates change).
VOYAGE_PRICE_PER_1M_TOKENS=

# OpenAI (alternative)
OPENAI_API_KEY=
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
# Optional, USD per 1M tokens — enables `codecontext usage` to estimate cost.
# Check current pricing at https://openai.com/api/pricing (rates change).
OPENAI_PRICE_PER_1M_TOKENS=

# Embedding vector dimension.
# voyage-code-3 = 1024, text-embedding-3-small = 1536
# Must match the provider/model. Changing it requires re-running init-db + reindex.
EMBEDDING_DIM=1024

# Max file size to index (bytes)
MAX_FILE_SIZE=1048576

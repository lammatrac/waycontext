# PostgreSQL connection (pgvector extension required).
# install.sh generates a random password for a fresh setup and writes the real
# URL here; this placeholder is only what you'd use configuring by hand.
DATABASE_URL=postgres://codectx:codectx@localhost:5432/codectx

# Embedding provider: "voyage" | "openai" | "none"
# "none" disables vector search (graph + keyword tools still work)
EMBEDDING_PROVIDER=voyage

# Voyage AI (recommended for code: voyage-code-3)
VOYAGE_API_KEY=
VOYAGE_MODEL=voyage-code-3
# Optional, USD per 1M tokens — enables `codecontext usage` to estimate cost.
# Check current pricing at https://docs.voyageai.com/docs/pricing (rates change).
VOYAGE_PRICE_PER_1M_TOKENS=

# OpenAI (alternative)
OPENAI_API_KEY=
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
# Optional, USD per 1M tokens — enables `codecontext usage` to estimate cost.
# Check current pricing at https://openai.com/api/pricing (rates change).
OPENAI_PRICE_PER_1M_TOKENS=

# Embedding vector dimension.
# voyage-code-3 = 1024, text-embedding-3-small = 1536
# Must match the provider/model. Changing it requires re-running init-db + reindex.
EMBEDDING_DIM=1024

# Max file size to index (bytes)
MAX_FILE_SIZE=1048576

# Organisation that owns the projects indexed by this install. A local setup
# has exactly one; the column exists so adding more isn't a data migration.
ORG_SLUG=default

# --- Git history (get_history / who_owns) ---
# Indexing also reads the repo's git log. Entirely local: no keys, no network.
# Set to 0 to skip it.
HISTORY_ENABLED=1
# Bounds on the FIRST pass over a repository, so a first index of a decade-old
# monorepo doesn't spend minutes on history nobody will ask about. Later runs
# read only sha..HEAD and ignore these. Set either to 0 to remove the bound.
HISTORY_WINDOW_MONTHS=24
HISTORY_MAX_COMMITS=20000
# who_owns weights each commit by exp(-ln2 * age / half-life), so the answer is
# whoever still has the code in their head rather than whoever wrote the most
# lines years ago.
OWNERSHIP_HALF_LIFE_DAYS=180

# --- Docs / ADR ingestion (Phase 2) ---------------------------------------
# In-repo Markdown (READMEs, guides, ADRs) is chunked and indexed alongside
# code, and answers "why is it like this" through search_knowledge.
DOCS_ENABLED=1
# Comma-separated glob patterns, matched against repo-relative paths.
# .gitignore and the built-in ignores (node_modules, vendor, dist…) still apply.
DOCS_GLOBS=**/*.md,**/*.mdx
# Target chunk size in characters. The hard cap is 8000, matching the input
# slice in src/embeddings.js — a chunk must never differ from what was embedded.
DOCS_CHUNK_CHARS=4800

# --- Rules & engineering memory (Phase 3) ---------------------------------
# Heuristic extraction from ADRs, docs and fix commits PROPOSES rules; a human
# confirms them with `waycontext rule confirm <id>` or by committing them to
# .waycontext/knowledge/rules.yaml. Only confirmed rules are ever injected into
# an agent's context — a confidently wrong rule makes the agent measurably worse.
RULES_ENABLED=1
# Sentences scoring below this are not even stored as candidates. Confidence
# comes from cue strength ("never" > "must" > "should"), not from a model.
RULE_CANDIDATE_MIN_CONFIDENCE=0.4
# Git-tracked team sharing: rules.yaml, candidates.yaml, memories.yaml.
KNOWLEDGE_DIR=.waycontext/knowledge

# Set to 1 to ignore .env files entirely and read configuration only from the
# environment (and ~/.config/waycontext/config.json). Useful in containers,
# where a bind-mounted source tree's .env would otherwise take over.
# WAYCONTEXT_IGNORE_DOTENV=1
